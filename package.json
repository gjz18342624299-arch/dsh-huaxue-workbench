{
  "name": "dsh-huaxue-workbench",
  "version": "0.4.0-rc.1",
  "description": "花少2花学工作台：七位花学旅伴陪你工作、聊天与借个嘴",
  "type": "module",
  "license": "MIT",
  "author": "gjz18342624299-arch",
  "repository": {
    "type": "git",
    "url": "https://github.com/gjz18342624299-arch/dsh-huaxue-workbench"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "scripts",
    "cordis.patch.yml",
    "compatibility.json",
    "README.md",
    "INSTALL.md",
    "VALIDATION.md",
    "RIGHTS.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "prepack": "npm run build && npm run check && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.7-rc.2 <0.2.0-0"
  },
  "dependencies": {
    "yaml": "2.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-desktop-workbenches",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    }
  }
}
